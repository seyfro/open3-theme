{
  "$schema": "https://schemas.wp.org/wp/6.5/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "link": true,
      "palette": [
        { "slug": "bg", "name": "Grund", "color": "#f3f2f2" },
        { "slug": "surface", "name": "Fläche", "color": "#eae9e9" },
        { "slug": "text", "name": "Text", "color": "#201e1d" },
        { "slug": "accent", "name": "Akzent", "color": "#ec3013" },
        { "slug": "accent-100", "name": "Akzent 100", "color": "#fff2ef" },
        { "slug": "accent-200", "name": "Akzent 200", "color": "#ffe0d9" },
        { "slug": "accent-600", "name": "Akzent 600", "color": "#dd2b0f" },
        { "slug": "accent-700", "name": "Akzent 700", "color": "#ae1800" },
        { "slug": "accent-800", "name": "Akzent 800", "color": "#7c1405" },
        { "slug": "neutral-100", "name": "Neutral 100", "color": "#f8f4f4" },
        { "slug": "neutral-300", "name": "Neutral 300", "color": "#d7d3d3" },
        { "slug": "neutral-600", "name": "Neutral 600", "color": "#7d7979" },
        { "slug": "neutral-700", "name": "Neutral 700", "color": "#605d5d" },
        { "slug": "neutral-800", "name": "Neutral 800", "color": "#444141" },
        { "slug": "neutral-900", "name": "Neutral 900", "color": "#2d2b2b" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": false,
      "dropCap": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "lineHeight": false,
      "textDecoration": false,
      "textTransform": false,
      "fontFamilies": [
        {
          "slug": "archivo",
          "name": "Archivo",
          "fontFamily": "\"Archivo\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontWeight": "400 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Archivo-latin.woff2" ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Archivo",
              "fontWeight": "400 800",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": [ "file:./assets/fonts/Archivo-latin-ext.woff2" ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Klein", "size": "13px" },
        { "slug": "medium", "name": "Normal", "size": "15px" },
        { "slug": "large", "name": "Fließtext", "size": "17px" },
        { "slug": "x-large", "name": "Zwischentitel", "size": "24px" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "spacingScale": { "steps": 0 },
      "units": [ "px" ],
      "padding": false,
      "margin": false,
      "blockGap": false,
      "spacingSizes": [
        { "slug": "1", "name": "4", "size": "4px" },
        { "slug": "2", "name": "8", "size": "8px" },
        { "slug": "3", "name": "12", "size": "12px" },
        { "slug": "4", "name": "16", "size": "16px" },
        { "slug": "6", "name": "24", "size": "24px" },
        { "slug": "8", "name": "32", "size": "32px" }
      ]
    },
    "layout": {
      "contentSize": "66ch",
      "wideSize": "800px"
    },
    "shadow": {
      "defaultPresets": false
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--archivo)",
      "fontSize": "15px",
      "lineHeight": "1.55",
      "fontWeight": "400"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--accent-700)" },
        "typography": { "textDecoration": "underline" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--accent-600)" }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "800",
          "lineHeight": "1.12",
          "letterSpacing": "-0.015em"
        }
      },
      "h1": {
        "typography": { "fontSize": "clamp(30px, 3.6vw, 44px)", "lineHeight": "1.06", "letterSpacing": "-0.02em" }
      },
      "h2": {
        "typography": { "fontSize": "24px", "lineHeight": "1.15", "letterSpacing": "-0.01em" }
      },
      "h3": {
        "typography": { "fontSize": "20px", "lineHeight": "1.2" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--bg)"
        },
        "border": { "radius": "0" },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontWeight": "800",
          "fontSize": "14px"
        },
        ":hover": {
          "color": { "background": "var(--wp--preset--color--accent-600)" }
        }
      }
    }
  }
}
