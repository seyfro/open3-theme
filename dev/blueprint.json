{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.4", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    { "step": "setSiteLanguage", "language": "de_AT" },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "open3.at",
        "blogdescription": "Netzwerk zur Förderung von OpenSociety, OpenGov und OpenData in Österreich",
        "posts_per_page": "5",
        "permalink_structure": "/%year%/%monthnum%/%postname%",
        "category_base": "kategorie",
        "timezone_string": "Europe/Vienna",
        "date_format": "j. F Y",
        "show_on_front": "posts",
        "default_comment_status": "open",
        "comment_moderation": "1"
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": { "WP_DEBUG": true, "WP_DEBUG_LOG": true, "WP_DEBUG_DISPLAY": false }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "wordpress.org/plugins", "slug": "newsletter" },
      "options": { "activate": true }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "wordpress.org/plugins", "slug": "kadence-blocks" },
      "options": { "activate": true }
    },
    { "step": "activateTheme", "themeFolderName": "open3" },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/themes/open3/dev/seed.php'; open3_seed_fixtures(); flush_rewrite_rules(); echo 'Fixtures angelegt.';"
    }
  ]
}
